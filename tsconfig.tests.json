{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tests/setup.ts"
  ],
  "exclude": ["node_modules", "dist", "out"]
}
